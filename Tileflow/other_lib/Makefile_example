MKL_PREFIX = path_to_MKL/MKL/2025.3
MKL_INC    = $(MKL_PREFIX)/include
MKL_LIB    = $(MKL_PREFIX)/lib/intel64/libmkl_rt.so
LIBIOMP_LIB    = /home/nudt/ywl/MKL/MKL/2025.3/lib/libiomp5.so 

OTHER_LIBS  = -lpthread -lm -ldl -lnuma

CC          = g++ -march=native
CFLAGS      = -O2 -I$(MKL_INC)
LINKER      = $(CC)

OBJS        = test.o

%.o: %.c
	 $(CC) $(CFLAGS) -fopenmp -c $< -o $@

all: $(OBJS)
	$(LINKER) $(OBJS) $(CFLAGS) $(LIBIOMP_LIB) $(OTHER_LIBS) $(MKL_LIB) -o a.out

clean:
	rm -rf *.o a.out
